{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "OneAccess Demo",
		"description": "Manage user accounts across multiple sites in a WordPress network.",
		"author": "rtCamp"
	},
	"landingPage": "/wp-admin/plugins.php",
	"preferredVersions": {
		"php": "8.4",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/rtCamp/OneAccess/releases/latest/download/oneaccess.zip"
			},
			"options": {
				"activate": true
			}
		}
	]
}
