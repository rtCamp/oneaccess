{
	"name": "rtcamp/oneaccess",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "rtCamp",
			"email": "marketing@rtcamp.com",
			"homepage": "https://rtcamp.com"
		}
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true,
			"composer/installers": true
		},
		"platform": {
			"php": "8.0"
		},
		"sort-packages": true,
		"preferred-install": "dist",
		"process-timeout": 0,
		"optimize-autoloader": true
	},
	"extra": {
		"installer-paths": {
			"vendor/{$vendor}/{$name}/": [
				"wpackagist-plugin/plugin-check",
				"woocommerce/action-scheduler"
			]
		}
	},
	"minimum-stability": "alpha",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"OneAccess\\": "inc/",
			"OneAccess\\Tests\\": "tests/php/"
		},
		"files": [
			"vendor/woocommerce/action-scheduler/action-scheduler.php"
		]
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*",
				"wpackagist-theme/*"
			]
		},
		{
			"type": "vcs",
			"url": "https://github.com/rtCamp/coding-standards-d.git"
		}
	],
	"require": {
		"php": "^8",
		"woocommerce/action-scheduler": "^3.9.3"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.2",
		"phpcompatibility/php-compatibility": "^10.0.0-alpha",
		"phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan-deprecation-rules": "^2.0.3",
		"phpstan/phpstan-phpunit": "^2.0.3",
		"phpstan/phpstan": "^2.1.55",
		"phpunit/phpunit": "^8.5|^9.6",
		"rtcamp/coding-standards-d": "^0.1.1",
		"slevomat/coding-standard": "^8.0",
		"squizlabs/php_codesniffer": "^3.9",
		"szepeviktor/phpstan-wordpress": "^2.0.2",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.9",
		"wpackagist-plugin/plugin-check": "~1.6.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"clean": "rm -rf vendor vendor-prefixed",
		"format": "phpcbf",
		"lint": "phpcs",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "vendor/bin/phpunit -c phpunit.xml.dist",
		"test-multisite": "WP_MULTISITE=1 phpunit --exclude-group=ms-excluded"
	}
}
